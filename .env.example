# OmniX Wiss release-signing variables only. Never commit real credentials.

# macOS Developer ID certificate bundle (optional if already installed in Keychain)
CSC_LINK=
CSC_KEY_PASSWORD=

# macOS notarization — Apple ID method
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# macOS notarization — App Store Connect API key method (alternative)
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Windows Authenticode certificate
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
